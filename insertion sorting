// insertion sorting

#include<stdio.h>

void isort(int a[] , int n )
{
    
    int temp , j;
    for(int i=1 ; i<n;i++)
    {
        temp = a[i];
        j = i-1;
        while( j >= 0 && temp < a[j])
        {
            a[j+1] = a[j];
            j--;
        }
        a[j+1] = temp;
    }
    

}

void display(int a[] ,int n)
{
    for(int i=0;i<n;i++)
    {
        printf("%d\t",a[i]);
    }
}
int main()
{
    int n , a[100];
    printf("enter the size \n" );
    scanf("%d",&n);
    printf("\n enter the elements : \n");
    for(int i=0;i<n;i++)
    {
        scanf("%d",&a[i]);
    }
    
    isort(a,n);
    display(a,n);
}
